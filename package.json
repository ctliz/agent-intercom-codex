{
  "name": "@ctliz/agent-intercom-codex",
  "version": "0.12.0-connect.7",
  "description": "Codex MCP plugin and wakeable worker for local messaging with Pi, Claude Code, OpenCode, Grok Build, and AGY agents.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "dist/codex-server.mjs",
  "bin": {
    "codex-intercom-mcp": "dist/codex-server.mjs",
    "codex-intercom-bridge": "dist/bridge-daemon.mjs",
    "coi": "dist/coi.mjs"
  },
  "files": [
    "assets/**/*",
    "dist/**/*",
    "codex/**/*.ts",
    "!codex/**/*.test.ts",
    "broker/**/*.ts",
    "!broker/**/*.test.ts",
    "protocol-v4/**/*.ts",
    "!protocol-v4/**/*.test.ts",
    "provider/protected-service.ts",
    "provider/provider.mjs",
    "!provider/entry.ts",
    "scripts/**/*",
    "!scripts/**/*.test.mjs",
    "!scripts/build-protected-provider.mjs",
    "skills/**/*",
    "types.ts",
    "config.ts",
    "tsconfig.json",
    "durable-json.ts",
    "boss-control-outbox.ts",
    "outbound-outbox.ts",
    ".codex-plugin/**/*",
    ".mcp.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses/**/*",
    "COPYRIGHT",
    "LICENSE_TRANSITION.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:protected-provider": "node scripts/build-protected-provider.mjs",
    "prepack": "npm run build:protected-provider",
    "prepare": "npm run build",
    "codex:mcp": "tsx codex/server.ts",
    "codex:bridge": "tsx codex/bridge-daemon.ts",
    "coi": "tsx codex/coi.ts",
    "test": "node --import tsx --test broker/*.test.ts boss-control-outbox.test.ts outbound-outbox.test.ts codex/*.test.ts protocol-v4/*.test.ts provider/*.test.ts scripts/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "codex",
    "mcp",
    "intercom",
    "multi-agent",
    "pi",
    "claude",
    "opencode",
    "grok",
    "grok-build",
    "agy"
  ],
  "peerDependencies": {
    "@ctliz/agent-intercom-core": "0.2.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@ctliz/agent-intercom-core": "0.2.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ctliz/agent-intercom-codex.git"
  },
  "homepage": "https://github.com/ctliz/agent-intercom-codex#readme",
  "bugs": {
    "url": "https://github.com/ctliz/agent-intercom-codex/issues"
  }
}
